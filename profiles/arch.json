{
  "name": "Arch Linux · GNOME",
  "os_id": "arch",
  "manager": "pacman",
  "cleanup": {
    "remove_exact": [
      "decibels",
      "epiphany",
      "evolution",
      "gnome-characters",
      "gnome-connections",
      "gnome-contacts",
      "gnome-font-viewer",
      "gnome-logs",
      "gnome-maps",
      "gnome-music",
      "gnome-software",
      "gnome-sound-recorder",
      "gnome-tour",
      "gnome-user-docs",
      "gnome-user-share",
      "gnome-weather",
      "libreoffice-fresh",
      "libreoffice-still",
      "malcontent",
      "rygel",
      "seahorse",
      "shotwell",
      "showtime",
      "simple-scan",
      "snapshot",
      "totem",
      "vim",
      "xterm",
      "yelp"
    ],
    "remove_prefix": [],
    "allowed_dependents": [],
    "protect": [
      "gdm",
      "gnome-shell",
      "gnome-session",
      "gnome-control-center",
      "gnome-settings-daemon",
      "gnome-keyring",
      "evolution-data-server",
      "networkmanager",
      "openssh",
      "nautilus",
      "gnome-console",
      "gnome-terminal",
      "ptyxis",
      "firefox",
      "google-chrome",
      "gnome-calculator",
      "gnome-disk-utility",
      "gnome-system-monitor",
      "papers",
      "evince",
      "loupe",
      "gnome-text-editor",
      "file-roller",
      "gjs",
      "gtk4",
      "libadwaita",
      "libgweather-4",
      "libsoup3",
      "geoclue",
      "glib2",
      "python",
      "gnome-extensions-app",
      "gnome-calendar",
      "gnome-clocks",
      "gnome-tweaks",
      "libmalcontent",
      "tecla",
      "polkit",
      "sudo",
      "base",
      "linux",
      "linux-firmware",
      "amd-ucode",
      "mesa",
      "vulkan-radeon",
      "xf86-video-amdgpu",
      "pipewire",
      "pipewire-pulse",
      "wireplumber",
      "btrfs-progs",
      "ibus",
      "ibus-libpinyin",
      "noto-fonts-cjk",
      "noto-fonts-emoji",
      "glibc",
      "accountsservice"
    ]
  },
  "localization": {
    "language": "zh_CN.UTF-8",
    "generated_locales": [
      "zh_CN.UTF-8",
      "en_US.UTF-8"
    ],
    "packages": [
      "glibc",
      "glib2",
      "accountsservice",
      "ibus",
      "ibus-libpinyin",
      "noto-fonts-cjk",
      "noto-fonts-emoji"
    ],
    "input_framework": "IBus",
    "input_method": "智能拼音（libpinyin）",
    "input_sources": [
      [
        "xkb",
        "us"
      ],
      [
        "ibus",
        "libpinyin"
      ]
    ]
  },
  "tool_packages": [
    "gnome-calendar",
    "gnome-clocks",
    "gnome-tweaks",
    "gnome-extensions-app",
    "nautilus",
    "gnome-console",
    "gnome-calculator",
    "gnome-text-editor",
    "gnome-system-monitor",
    "gnome-disk-utility",
    "file-roller",
    "loupe",
    "papers"
  ],
  "desktop_settings": {
    "org.gnome.desktop.wm.preferences": {
      "button-layout": "'appmenu:minimize,maximize,close'"
    },
    "org.gnome.desktop.interface": {
      "clock-format": "'24h'",
      "clock-show-weekday": "true",
      "clock-show-date": "true",
      "clock-show-seconds": "true",
      "gtk-enable-primary-paste": "true"
    },
    "org.gnome.desktop.calendar": {
      "show-weekdate": "true"
    },
    "org.gnome.shell": {
      "favorite-apps": "['org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Console.desktop']"
    }
  },
  "monitor_auto_gpu": true
}
