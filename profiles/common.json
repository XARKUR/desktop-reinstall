{
  "environment": [
    "Docker",
    "fnm（管理 Node.js）",
    "uv（管理 Python）"
  ],
  "apps": [
    "Gnome Weather",
    "GNOME 扩展"
  ],
  "appearance": [
    "gnome-appearance"
  ],
  "extensions": [
    "Gnome Lunar",
    "Dash to Dock",
    "AppIndicator and KStatusNotifierItem Support",
    "Gnome Monitor"
  ],
  "projects": {
    "gnome-appearance": {
      "repository": "XARKUR/gnome-appearance",
      "commit": "7ed34d987fa3625b45c7d9417b3d054261eb8c1c",
      "includes": [
        "Orchis-Dark",
        "Tela-dark",
        "Breeze 24",
        "User Themes",
        "GTK4 全局外观",
        "活动按钮按系统选择 Debian / Arch 图标"
      ]
    },
    "Gnome Monitor": {
      "repository": "XARKUR/gnome-monitor",
      "commit": "c282e4dbbd4b7a258b1a51a69eb01eaaf481f8c8",
      "includes": [
        "顶栏资源监控",
        "AMD / Intel 自动型号识别",
        "NVIDIA 指标（需要 nvidia-smi）"
      ],
      "uuid": "resource-monitor@system.local",
      "schema": "org.gnome.shell.extensions.system-resource-monitor",
      "initial_settings": {
        "cpustatus": "true",
        "ramstatus": "true",
        "netethstatus": "true",
        "gpudisplaydevicename": "true"
      }
    },
    "Gnome Lunar": {
      "repository": "XARKUR/gnome-lunar",
      "commit": "c450a528d6cb03dfd0abcde554d5318e5f6f512b",
      "includes": [
        "顶栏和月历农历"
      ],
      "uuid": "lunar-calendar@system.local",
      "schema": "org.gnome.shell.extensions.system-lunar-calendar",
      "initial_settings": {
        "show-date": "true",
        "show-time": "true",
        "show-calendar": "true",
        "show-details": "true",
        "show-ganzhi": "true",
        "show-festivals": "true",
        "show-solar-terms": "true",
        "label-size": "'normal'"
      }
    },
    "Gnome Weather": {
      "repository": "XARKUR/gnome-weather-local",
      "commit": "f42e48445cafd47f8b776c7eadf63a8319e35222",
      "includes": [
        "天气应用",
        "日历天气卡片"
      ],
      "uuid": "weather@system.local",
      "schema": "org.gnome.Weather.Local"
    }
  },
  "system_apps": {
    "GNOME 扩展": {
      "debian13": "gnome-shell-extension-prefs",
      "arch": "gnome-extensions-app"
    }
  },
  "system_extensions": {
    "Dash to Dock": {
      "uuid": "dash-to-dock@micxgx.gmail.com",
      "debian13": "gnome-shell-extension-dashtodock",
      "arch": {
        "url": "https://extensions.gnome.org/download-extension/dash-to-dock@micxgx.gmail.com.shell-extension.zip?version_tag=76105",
        "sha256": "b05003e79835a35451e94931539ba1977f2a7a93b652a4fc6b7be60a77c18ae1",
        "version": 110
      },
      "settings": {
        "require-pressure-to-show": false,
        "dock-position": "BOTTOM",
        "intellihide": true,
        "autohide": true,
        "dock-fixed": false,
        "dash-max-icon-size": 48,
        "extend-height": false
      }
    },
    "AppIndicator and KStatusNotifierItem Support": {
      "uuid": {
        "debian13": "ubuntu-appindicators@ubuntu.com",
        "arch": "appindicatorsupport@rgcjonas.gmail.com"
      },
      "debian13": "gnome-shell-extension-appindicator",
      "arch": "gnome-shell-extension-appindicator"
    }
  },
  "environment_settings": {
    "docker": {
      "source": "official-stable",
      "compose": true,
      "buildx": true,
      "add_user_to_group": true,
      "arch_source": "official-repository"
    },
    "fnm": {
      "version": "1.39.0",
      "node_versions": []
    },
    "uv": {
      "version": "0.13.7",
      "python_versions": []
    }
  }
}
