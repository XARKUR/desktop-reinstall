{
  "name": "Debian 13 · GNOME",
  "os_id": "debian",
  "version_id": "13",
  "manager": "apt",
  "cleanup": {
    "name": "minimal",
    "remove_exact": [
      "evolution",
      "evolution-common",
      "evolution-ews",
      "evolution-ews-core",
      "evolution-plugin-bogofilter",
      "evolution-plugin-pstimport",
      "evolution-plugins",
      "gnome-characters",
      "gnome-connections",
      "gnome-contacts",
      "gnome-font-viewer",
      "gnome-logs",
      "gnome-maps",
      "gnome-music",
      "gnome-snapshot",
      "gnome-software",
      "gnome-software-common",
      "gnome-software-plugin-deb",
      "gnome-software-plugin-fwupd",
      "gnome-sound-recorder",
      "gnome-tour",
      "gnome-user-docs",
      "gnome-user-share",
      "gnome-weather",
      "malcontent-gui",
      "rygel",
      "rygel-playbin",
      "rygel-tracker",
      "seahorse",
      "shotwell",
      "shotwell-common",
      "simple-scan",
      "totem",
      "totem-common",
      "totem-plugins",
      "vim-common",
      "vim-tiny",
      "xterm",
      "yelp"
    ],
    "remove_prefix": [
      "libreoffice-"
    ],
    "allowed_dependents": [
      "libevolution",
      "python3-uno",
      "gnome",
      "gnome-core",
      "task-gnome-desktop"
    ],
    "protect": [
      "gdm3",
      "gnome-shell",
      "gnome-shell-common",
      "gnome-session",
      "gnome-session-bin",
      "gnome-settings-daemon",
      "gnome-control-center",
      "network-manager",
      "openssh-server",
      "polkitd",
      "gnome-keyring",
      "evolution-data-server",
      "nautilus",
      "gnome-terminal",
      "firefox-esr",
      "deskflow",
      "gnome-tweaks",
      "gnome-system-monitor",
      "gnome-disk-utility",
      "gnome-calculator",
      "gnome-text-editor",
      "file-roller",
      "loupe",
      "evince",
      "pipewire-audio",
      "gjs",
      "python3",
      "libglib2.0-bin",
      "gir1.2-gtk-4.0",
      "gir1.2-adw-1",
      "gir1.2-gweather-4.0",
      "gir1.2-soup-3.0",
      "gir1.2-geoclue-2.0",
      "fonts-noto-color-emoji",
      "gnome-calendar",
      "gnome-clocks",
      "locales",
      "locales-all",
      "ibus",
      "ibus-libpinyin",
      "im-config",
      "fonts-noto-cjk",
      "gnome-shell-extension-prefs",
      "gnome-shell-extension-dashtodock",
      "gnome-shell-extension-appindicator"
    ]
  },
  "localization": {
    "language": "zh_CN.UTF-8",
    "generated_locales": [
      "zh_CN.UTF-8",
      "en_US.UTF-8"
    ],
    "packages": [
      "locales",
      "fonts-noto-cjk",
      "fonts-noto-color-emoji",
      "ibus",
      "ibus-libpinyin"
    ],
    "input_framework": "IBus",
    "input_method": "智能拼音（libpinyin）",
    "input_sources": [
      [
        "xkb",
        "us"
      ],
      [
        "ibus",
        "libpinyin"
      ]
    ]
  },
  "tool_packages": [
    "gnome-calendar",
    "gnome-clocks",
    "gnome-tweaks",
    "gnome-shell-extension-prefs",
    "nautilus",
    "gnome-terminal",
    "gnome-calculator",
    "gnome-text-editor",
    "gnome-system-monitor",
    "gnome-disk-utility",
    "file-roller",
    "loupe",
    "evince"
  ]
}
